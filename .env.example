AI_PROVIDER=gemini

# Configure at least one provider for actual image analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative; leave unused provider keys blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Scan history and accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key. A service-role key is not needed.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
